#!/bin/sh
set -eu
# Test prefix only works in an explicitly marked sandbox. No live gadget in CI.
R=${AURORA_TEST_ROOT:-}
if [ -n "$R" ]; then
    [ "$R" != / ] && [ -f "$R/.aurora-test-root" ] || exit 64
    LIMIT=0
else
    LIMIT=30
fi
count=0
while :; do
    set -- "$R"/sys/class/udc/*
    if [ -e "$1" ]; then
        [ "$#" -eq 1 ] || { echo 'Multiple UDCs; not guessing' >&2; exit 3; }
        UDC=${1##*/}
        break
    fi
    [ "$count" -lt "$LIMIT" ] || { echo 'No UDC within deadline' >&2; exit 2; }
    sleep 1
    count=$((count + 1))
done
CFG="$R/sys/kernel/config"
if [ -z "$R" ] && ! grep -q ' /sys/kernel/config configfs ' /proc/mounts; then
    mount -t configfs configfs "$CFG"
fi
G="$CFG/usb_gadget/aurora_stage20"
mkdir -p "$G"
# Linux gadget example identifiers: private development use, not assigned IDs.
echo 0x1d6b > "$G/idVendor"
echo 0x0104 > "$G/idProduct"
echo 0x0200 > "$G/bcdUSB"
echo 0x02 > "$G/bDeviceClass"
echo 0x02 > "$G/bDeviceSubClass"
echo 0x01 > "$G/bDeviceProtocol"
mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/acm.GS0"
echo 'Aurora development' > "$G/strings/0x409/manufacturer"
echo 'PW2 Stage20 serial test' > "$G/strings/0x409/product"
echo 'AURORA-STAGE20' > "$G/strings/0x409/serialnumber"
echo 'CDC ACM diagnostic' > "$G/configs/c.1/strings/0x409/configuration"
echo 0xC0 > "$G/configs/c.1/bmAttributes"
echo 2 > "$G/configs/c.1/MaxPower"
[ -L "$G/configs/c.1/acm.GS0" ] || ln -s "$G/functions/acm.GS0" "$G/configs/c.1/acm.GS0"
echo "$UDC" > "$G/UDC"
echo "AURORA_STAGE20_UDC_BOUND $UDC"
