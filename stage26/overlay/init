#!/aurora26/busybox sh
# Static C PID1 has armed its independent deadline before this shell starts.
PATH=/aurora26/bin
export PATH
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /run /tmp /dev/pts /sys/kernel/config
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
mount -t devpts devpts /dev/pts
exec </dev/null >/run/pid1.log 2>&1
echo '<5>AURORA_STAGE26_SHELL_STARTED: embedded static userspace' > /dev/kmsg
mkdir -p /lib/modules
KREL=$(uname -r)
[ -e "/lib/modules/$KREL" ] || ln -s . "/lib/modules/$KREL"
(
    /aurora26/acm > /run/acm.log 2>&1 || exit
    n=0
    while [ ! -c /dev/ttyGS0 ] && [ "$n" -lt 5 ]; do sleep 1; n=$((n+1)); done
    [ -c /dev/ttyGS0 ] || exit 1
    while :; do
        /aurora26/busybox getty -L -n -l /aurora26/console 115200 ttyGS0 vt100
        sleep 1
    done
) &
(
    echo "KERNEL_RELEASE=$KREL"
    echo VENDOR_MODULE_METADATA
    ls -la /lib/modules
    clear_usb_gate() {
        for p in /sys/devices/platform/soc/soc:extcon_usb_shim/force_disable /sys/bus/platform/devices/soc:extcon_usb_shim/force_disable; do
            if [ -e "$p" ]; then
                echo "USB_GATE_BEFORE=$p $(cat "$p")"
                echo 0 > "$p"
                echo "USB_GATE_STATUS=$? $p $(cat "$p")"
            fi
        done
    }
    modprobe -v google-extcon-usb-shim usb_force_disable_boot=0
    echo "SHIM_STATUS=$?"
    clear_usb_gate
    while IFS= read -r m; do
        case "$m" in ''|\#*) continue ;; esac
        echo "MODULE_BEGIN=$m"
        modprobe -v "${m%.ko}"
        echo "MODULE_STATUS=$? $m"
    done < /aurora26/modules.load
    clear_usb_gate
    echo MODULE_PROBING_FINISHED
) > /run/modules.log 2>&1 &
while :; do wait; sleep 1; done
