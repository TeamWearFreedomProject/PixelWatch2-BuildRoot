# Alternative AArch32 userspace matching the Android device-tree ABI.
# Intended for ARM64 kernel with CONFIG_COMPAT=y and CONFIG_COMPAT_BINFMT_ELF=y.
# Rootfs only. NOT A BOOT IMAGE. DO NOT FLASH.
BR2_arm=y
BR2_cortex_a53=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="aurora"
BR2_TARGET_GENERIC_ISSUE="Aurora experimental Linux (ARM32)"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AURORA_WATCH_PATH)/board/google/aurora/rootfs-overlay"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_TAR=y
